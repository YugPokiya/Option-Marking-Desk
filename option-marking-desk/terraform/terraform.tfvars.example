# cp terraform.tfvars.example terraform.tfvars
region      = "ap-south-1"
environment = "prod"
github_repo = "YugPokiya/option-marking-desk"

# instance_type         = "t3.micro"
# asg_min_size          = 2
# asg_max_size          = 4
# asg_health_check_type = "ELB"      # after the first successful deployment
# use_nat_gateway       = false
# certificate_arn       = "arn:aws:acm:ap-south-1:<acct>:certificate/<id>"
# alarm_email           = "you@example.com"
# create_github_oidc_provider = false  # if deploy/aws/github-oidc.sh already created it
# create_ecr_repositories     = false  # if aws-up.sh already created omd-api / omd-web
# deletion_protection   = false        # for a throwaway test stack
